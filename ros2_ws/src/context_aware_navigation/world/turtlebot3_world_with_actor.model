<?xml version="1.0"?>
<!--
  TurtleBot3 world (same as nav2_bringup/worlds/world_only.model) plus a
  Gazebo <actor> standing at (1.5, 0).  Loaded directly by gzserver, so it
  bypasses gazebo_ros spawn_entity.py — which is required because
  spawn_entity.py only handles <model> / <light> elements, not <actor>.

  The actor loops walk.dae in place (no <script>/<trajectory>) so it stays
  put.  Use a trajectory block later if you want a wandering pedestrian.
-->
<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0 0 10 0 1.570796 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name="turtlebot3_world">
      <static>1</static>
      <include>
        <uri>model://turtlebot3_world</uri>
      </include>
    </model>

    <!-- ====================================================== -->
    <!--   Nav2CAN-added humanoid actor at (1.5, 0)              -->
    <!-- ====================================================== -->
    <actor name="nav2can_person1">
      <pose>1.5 0.0 0.0 0 0 3.14159</pose>
      <skin>
        <filename>/usr/share/gazebo-11/media/models/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>/usr/share/gazebo-11/media/models/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
    </actor>

  </world>
</sdf>
